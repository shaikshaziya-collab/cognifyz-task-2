<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Cognifyz | Experience Hub</title>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #070711;
            --card: rgba(17, 17, 31, 0.78);
            --border: rgba(255, 255, 255, 0.09);
            --text: #f8fafc;
            --muted: #94a3b8;
            --purple: #8b5cf6;
            --violet: #a855f7;
            --cyan: #22d3ee;
            --green: #34d399;
            --red: #fb7185;
        }

        body {
            min-height: 100vh;
            font-family: "Inter", sans-serif;
            color: var(--text);
            background:
                radial-gradient(circle at 10% 10%, rgba(139, 92, 246, 0.18), transparent 28%),
                radial-gradient(circle at 90% 20%, rgba(34, 211, 238, 0.12), transparent 25%),
                radial-gradient(circle at 50% 100%, rgba(168, 85, 247, 0.12), transparent 30%),
                var(--bg);

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 35px 18px;

            overflow-x: hidden;
        }

        /* Ambient lights */

        body::before,
        body::after {
            content: "";
            position: fixed;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.18;
            pointer-events: none;
            animation: float 8s ease-in-out infinite alternate;
        }

        body::before {
            background: var(--purple);
            top: -100px;
            left: -100px;
        }

        body::after {
            background: var(--cyan);
            bottom: -120px;
            right: -100px;
            animation-delay: 2s;
        }

        @keyframes float {
            from {
                transform: translateY(0);
            }

            to {
                transform: translateY(30px);
            }
        }

        /* Main application */

        .app {
            position: relative;
            width: 100%;
            max-width: 1180px;

            display: grid;
            grid-template-columns: 0.85fr 1.15fr;

            background: rgba(10, 10, 20, 0.76);
            border: 1px solid var(--border);

            border-radius: 30px;

            backdrop-filter: blur(30px);
            -webkit-backdrop-filter: blur(30px);

            box-shadow:
                0 40px 100px rgba(0, 0, 0, 0.55),
                inset 0 1px rgba(255, 255, 255, 0.05);

            overflow: hidden;
        }

        /* Left side */

        .hero {
            position: relative;
            padding: 55px 48px;

            border-right: 1px solid var(--border);

            display: flex;
            flex-direction: column;
            justify-content: space-between;

            min-height: 720px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-logo {
            width: 42px;
            height: 42px;

            border-radius: 12px;

            display: flex;
            align-items: center;
            justify-content: center;

            font-weight: 800;
            font-size: 17px;

            color: white;

            background:
                linear-gradient(135deg, var(--purple), var(--cyan));

            box-shadow:
                0 0 25px rgba(139, 92, 246, 0.35);
        }

        .brand-name {
            font-size: 19px;
            font-weight: 800;
            letter-spacing: 1px;
        }

        .brand-subtitle {
            color: var(--muted);
            font-size: 10px;
            margin-top: 2px;
        }

        .hero-content {
            margin-top: 50px;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;

            padding: 7px 12px;

            border: 1px solid rgba(139, 92, 246, 0.25);
            border-radius: 100px;

            color: #c4b5fd;
            background: rgba(139, 92, 246, 0.08);

            font-size: 11px;
            font-weight: 600;

            margin-bottom: 22px;
        }

        .pulse {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--green);
            box-shadow: 0 0 12px var(--green);
        }

        .hero h1 {
            font-size: clamp(40px, 4vw, 58px);
            line-height: 1.02;
            letter-spacing: -2.5px;
            max-width: 500px;
        }

        .gradient-text {
            background: linear-gradient(
                90deg,
                #c4b5fd,
                #a78bfa,
                #67e8f9
            );

            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .hero-description {
            margin-top: 22px;

            color: var(--muted);

            font-size: 14px;
            line-height: 1.8;

            max-width: 440px;
        }

        /* Feature cards */

        .features {
            margin-top: 35px;

            display: grid;
            grid-template-columns: 1fr 1fr;

            gap: 12px;
        }

        .feature {
            padding: 15px;

            border: 1px solid var(--border);
            border-radius: 14px;

            background: rgba(255, 255, 255, 0.025);

            transition: 0.25s ease;
        }

        .feature:hover {
            transform: translateY(-3px);
            border-color: rgba(139, 92, 246, 0.35);
            background: rgba(139, 92, 246, 0.07);
        }

        .feature-icon {
            font-size: 18px;
            margin-bottom: 9px;
        }

        .feature strong {
            display: block;
            font-size: 12px;
            margin-bottom: 4px;
        }

        .feature span {
            font-size: 10px;
            color: var(--muted);
        }

        .hero-footer {
            color: #64748b;
            font-size: 10px;
        }

        /* Form */

        .form-area {
            padding: 45px;
        }

        .form-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;

            gap: 20px;

            margin-bottom: 28px;
        }

        .form-header small {
            color: #a78bfa;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .form-header h2 {
            margin-top: 7px;

            font-size: 28px;
            letter-spacing: -0.8px;
        }

        .form-header p {
            margin-top: 7px;

            color: var(--muted);

            font-size: 12px;
        }

        .task-badge {
            padding: 8px 12px;

            border: 1px solid rgba(34, 211, 238, 0.2);
            border-radius: 10px;

            background: rgba(34, 211, 238, 0.06);

            color: #67e8f9;

            font-size: 10px;
            font-weight: 700;

            white-space: nowrap;
        }

        /* Server messages */

        .server-message {
            padding: 13px 15px;

            border-radius: 12px;

            margin-bottom: 20px;

            font-size: 12px;
            font-weight: 600;
        }

        .server-error {
            color: #fecdd3;
            background: rgba(251, 113, 133, 0.08);
            border: 1px solid rgba(251, 113, 133, 0.2);
        }

        .server-success {
            color: #a7f3d0;
            background: rgba(52, 211, 153, 0.08);
            border: 1px solid rgba(52, 211, 153, 0.2);
        }

        /* Inputs */

        .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .field {
            position: relative;
        }

        .full {
            grid-column: span 2;
        }

        label {
            display: block;

            color: #cbd5e1;

            font-size: 11px;
            font-weight: 600;

            margin-bottom: 8px;
        }

        .required {
            color: var(--violet);
        }

        input,
        select,
        textarea {
            width: 100%;

            border: 1px solid rgba(255, 255, 255, 0.09);
            border-radius: 11px;

            background: rgba(255, 255, 255, 0.035);

            color: white;

            padding: 13px 14px;

            outline: none;

            font-family: inherit;
            font-size: 12px;

            transition: 0.25s ease;
        }

        input::placeholder,
        textarea::placeholder {
            color: #475569;
        }

        select {
            cursor: pointer;
        }

        select option {
            background: #11111f;
            color: white;
        }

        textarea {
            min-height: 115px;
            resize: vertical;
        }

        input:focus,
        select:focus,
        textarea:focus {
            border-color: rgba(139, 92, 246, 0.7);

            background: rgba(139, 92, 246, 0.035);

            box-shadow:
                0 0 0 3px rgba(139, 92, 246, 0.08),
                0 0 25px rgba(139, 92, 246, 0.07);
        }

        /* Rating */

        .rating-box {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .stars {
            display: flex;
            flex-direction: row-reverse;
            justify-content: flex-end;
            gap: 4px;
        }

        .stars input {
            display: none;
        }

        .stars label {
            cursor: pointer;

            font-size: 26px;

            color: #334155;

            transition: 0.2s ease;
        }

        .stars label:hover,
        .stars label:hover ~ label,
        .stars input:checked ~ label {
            color: #fbbf24;
            text-shadow: 0 0 14px rgba(251, 191, 36, 0.4);
        }

        .rating-text {
            color: #64748b;
            font-size: 10px;
        }

        /* Error */

        .error-text {
            display: none;

            color: var(--red);

            font-size: 10px;

            margin-top: 6px;
        }

        /* Checkbox */

        .agreement {
            margin-top: 18px;

            display: flex;
            align-items: center;

            gap: 9px;

            color: #64748b;

            font-size: 10px;
        }

        .agreement input {
            width: 15px;
            height: 15px;

            accent-color: var(--purple);

            cursor: pointer;
        }

        /* Button */

        .submit-btn {
            position: relative;

            width: 100%;

            margin-top: 22px;

            padding: 15px;

            border: none;
            border-radius: 12px;

            background:
                linear-gradient(
                    100deg,
                    #7c3aed,
                    #8b5cf6,
                    #06b6d4
                );

            color: white;

            font-family: inherit;

            font-size: 12px;
            font-weight: 700;

            cursor: pointer;

            overflow: hidden;

            transition: 0.3s ease;

            box-shadow:
                0 12px 30px rgba(124, 58, 237, 0.2);
        }

        .submit-btn::before {
            content: "";

            position: absolute;

            top: 0;
            left: -100%;

            width: 60%;
            height: 100%;

            background: linear-gradient(
                90deg,
                transparent,
                rgba(255,255,255,0.25),
                transparent
            );

            transform: skewX(-20deg);

            transition: 0.6s;
        }

        .submit-btn:hover {
            transform: translateY(-2px);

            box-shadow:
                0 18px 35px rgba(124, 58, 237, 0.3);
        }

        .submit-btn:hover::before {
            left: 130%;
        }

        .form-footer {
            text-align: center;

            color: #475569;

            font-size: 9px;

            margin-top: 14px;
        }

        /* Responsive */

        @media (max-width: 900px) {

            .app {
                grid-template-columns: 1fr;
            }

            .hero {
                min-height: auto;

                border-right: none;
                border-bottom: 1px solid var(--border);
            }

            .hero-content {
                margin-top: 35px;
            }
        }

        @media (max-width: 600px) {

            body {
                padding: 10px;
            }

            .hero,
            .form-area {
                padding: 30px 22px;
            }

            .features {
                grid-template-columns: 1fr;
            }

            .grid {
                grid-template-columns: 1fr;
            }

            .full {
                grid-column: span 1;
            }

            .form-header {
                flex-direction: column;
            }

            .hero h1 {
                font-size: 40px;
            }
        }
    </style>
</head>

<body>

<div class="app">

    <!-- HERO -->

    <section class="hero">

        <div>

            <div class="brand">

                <div class="brand-logo">
                    C
                </div>

                <div>
                    <div class="brand-name">
                        COGNIFYZ
                    </div>

                    <div class="brand-subtitle">
                        WHERE DATA MEETS INTELLIGENCE
                    </div>
                </div>

            </div>


            <div class="hero-content">

                <div class="eyebrow">
                    <span class="pulse"></span>
                    EXPERIENCE HUB
                </div>

                <h1>
                    Your voice.
                    <span class="gradient-text">
                        Your experience.
                    </span>
                </h1>

                <p class="hero-description">
                    Tell us about your journey. This interactive
                    experience portal validates your information
                    before securely processing your response.
                </p>


                <div class="features">

                    <div class="feature">

                        <div class="feature-icon">
                            ⚡
                        </div>

                        <strong>
                            Instant Validation
                        </strong>

                        <span>
                            Smart browser-side checks
                        </span>

                    </div>


                    <div class="feature">

                        <div class="feature-icon">
                            🛡
                        </div>

                        <strong>
                            Server Validation
                        </strong>

                        <span>
                            Express validates your data
                        </span>

                    </div>


                    <div class="feature">

                        <div class="feature-icon">
                            ✦
                        </div>

                        <strong>
                            Interactive UI
                        </strong>

                        <span>
                            Built for a smooth experience
                        </span>

                    </div>


                    <div class="feature">

                        <div class="feature-icon">
                            ◈
                        </div>

                        <strong>
                            Smart Processing
                        </strong>

                        <span>
                            Temporary response storage
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <div class="hero-footer">
            COGNIFYZ INTERNSHIP • FULL STACK DEVELOPMENT • TASK 02
        </div>

    </section>


    <!-- FORM -->

    <section class="form-area">

        <div class="form-header">

            <div>

                <small>
                    Interactive Experience
                </small>

                <h2>
                    Share your experience
                </h2>

                <p>
                    A few details are all we need.
                </p>

            </div>

            <div class="task-badge">
                TASK 02
            </div>

        </div>


        <% if (error) { %>

            <div class="server-message server-error">
                ⚠ <%= error %>
            </div>

        <% } %>


        <% if (success) { %>

            <div class="server-message server-success">
                ✓ <%= success %>
            </div>

        <% } %>


        <form id="experienceForm"
              action="/submit"
              method="POST">


            <div class="grid">


                <!-- NAME -->

                <div class="field">

                    <label for="name">
                        Full Name <span class="required">*</span>
                    </label>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        placeholder="Enter your full name"
                    >

                    <div class="error-text" id="nameError">
                        Please enter your name.
                    </div>

                </div>


                <!-- EMAIL -->

                <div class="field">

                    <label for="email">
                        Email Address <span class="required">*</span>
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="you@example.com"
                    >

                    <div class="error-text" id="emailError">
                        Please enter a valid email.
                    </div>

                </div>


                <!-- PHONE -->

                <div class="field">

                    <label for="phone">
                        Phone Number <span class="required">*</span>
                    </label>

                    <input
                        type="tel"
                        id="phone"
                        name="phone"
                        placeholder="10-digit phone number"
                    >

                    <div class="error-text" id="phoneError">
                        Please enter a valid 10-digit number.
                    </div>

                </div>


                <!-- EXPERIENCE -->

                <div class="field">

                    <label for="experience">
                        Experience Type <span class="required">*</span>
                    </label>

                    <select
                        id="experience"
                        name="experience"
                    >

                        <option value="">
                            Select experience
                        </option>

                        <option value="Internship">
                            Internship
                        </option>

                        <option value="Training">
                            Training
                        </option>

                        <option value="Workshop">
                            Workshop
                        </option>

                        <option value="Other">
                            Other
                        </option>

                    </select>

                    <div class="error-text" id="experienceError">
                        Please select an experience type.
                    </div>

                </div>


                <!-- RATING -->

                <div class="field full">

                    <label>
                        Rate your experience
                    </label>

                    <div class="rating-box">

                        <div class="stars">

                            <input
                                type="radio"
                                name="rating"
                                id="star5"
                                value="5"
                            >

                            <label for="star5">★</label>


                            <input
                                type="radio"
                                name="rating"
                                id="star4"
                                value="4"
                            >

                            <label for="star4">★</label>


                            <input
                                type="radio"
                                name="rating"
                                id="star3"
                                value="3"
                            >

                            <label for="star3">★</label>


                            <input
                                type="radio"
                                name="rating"
                                id="star2"
                                value="2"
                            >

                            <label for="star2">★</label>


                            <input
                                type="radio"
                                name="rating"
                                id="star1"
                                value="1"
                            >

                            <label for="star1">★</label>

                        </div>

                        <span class="rating-text">
                            Select a rating
                        </span>

                    </div>

                    <div class="error-text" id="ratingError">
                        Please select a rating.
                    </div>

                </div>


                <!-- MESSAGE -->

                <div class="field full">

                    <label for="message">
                        Your Message <span class="required">*</span>
                    </label>

                    <textarea
                        id="message"
                        name="message"
                        maxlength="300"
                        placeholder="Tell us about your experience..."
                    ></textarea>

                    <div
                        style="
                        display:flex;
                        justify-content:space-between;
                        margin-top:6px;
                        "
                    >

                        <div
                            class="error-text"
                            id="messageError"
                        >
                            Please enter your message.
                        </div>

                        <span
                            id="counter"
                            style="
                            color:#475569;
                            font-size:9px;
                            "
                        >
                            0 / 300
                        </span>

                    </div>

                </div>

            </div>


            <!-- AGREEMENT -->

            <label class="agreement">

                <input
                    type="checkbox"
                    id="terms"
                >

                I confirm that the information provided is accurate.

            </label>

            <div class="error-text" id="termsError">
                Please confirm the information above.
            </div>


            <!-- SUBMIT -->

            <button
                type="submit"
                class="submit-btn"
            >
                Submit Experience →
            </button>


        </form>


        <div class="form-footer">
            Powered by Node.js • Express • EJS • JavaScript
        </div>

    </section>

</div>


<script>

    const form =
        document.getElementById("experienceForm");

    const message =
        document.getElementById("message");

    const counter =
        document.getElementById("counter");


    /* Character counter */

    message.addEventListener("input", function () {

        counter.textContent =
            `${message.value.length} / 300`;

    });


    /* Rating text */

    const ratingText =
        document.querySelector(".rating-text");

    const ratingInputs =
        document.querySelectorAll(
            'input[name="rating"]'
        );

    ratingInputs.forEach(input => {

        input.addEventListener("change", function () {

            ratingText.textContent =
                `${this.value} / 5 selected`;

            ratingText.style.color =
                "#fbbf24";

        });

    });


    /* Form validation */

    form.addEventListener("submit", function(event) {

        let valid = true;

        const name =
            document.getElementById("name");

        const email =
            document.getElementById("email");

        const phone =
            document.getElementById("phone");

        const experience =
            document.getElementById("experience");

        const terms =
            document.getElementById("terms");


        document
            .querySelectorAll(".error-text")
            .forEach(error => {
                error.style.display = "none";
            });


        /* Name */

        if (name.value.trim() === "") {

            document.getElementById(
                "nameError"
            ).style.display = "block";

            valid = false;

        }


        /* Email */

        const emailPattern =
            /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

        if (
            !emailPattern.test(
                email.value.trim()
            )
        ) {

            document.getElementById(
                "emailError"
            ).style.display = "block";

            valid = false;

        }


        /* Phone */

        const phonePattern =
            /^[0-9]{10}$/;

        if (
            !phonePattern.test(
                phone.value.trim()
            )
        ) {

            document.getElementById(
                "phoneError"
            ).style.display = "block";

            valid = false;

        }


        /* Experience */

        if (
            experience.value === ""
        ) {

            document.getElementById(
                "experienceError"
            ).style.display = "block";

            valid = false;

        }


        /* Rating */

        const rating =
            document.querySelector(
                'input[name="rating"]:checked'
            );

        if (!rating) {

            document.getElementById(
                "ratingError"
            ).style.display = "block";

            valid = false;

        }


        /* Message */

        if (
            message.value.trim() === ""
        ) {

            document.getElementById(
                "messageError"
            ).style.display = "block";

            valid = false;

        }


        /* Terms */

        if (!terms.checked) {

            document.getElementById(
                "termsError"
            ).style.display = "block";

            valid = false;

        }


        if (!valid) {

            event.preventDefault();

            window.scrollTo({
                top: 0,
                behavior: "smooth"
            });

        }

    });

</script>

</body>
</html>